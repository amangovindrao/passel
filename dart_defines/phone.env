# Build config for testing on a physical Android phone over Wi-Fi.
#
#   flutter build apk --debug --dart-define-from-file=../../dart_defines/phone.env
#
# The phone and this machine must be on the SAME Wi-Fi network, and the host
# firewall must allow inbound 8000 and 54321. If the app cannot reach the API,
# check that first — it is almost always the firewall or a guest network that
# isolates clients from each other.
#
# 10.142.171.71 is this machine's Wi-Fi address. It changes when the router
# hands out a new lease, so re-run scripts/build_apks.ps1 if login stops working
# after a reboot.

FLAVOR=dev

# Paasel API — uvicorn must be bound to 0.0.0.0, not 127.0.0.1.
API_BASE_URL=http://10.112.197.71:8000

# Local Supabase stack (npx supabase start). Phone-OTP codes are fixed in
# supabase/config.toml — every test number uses 123456.
SUPABASE_URL=http://10.112.197.71:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Empty is fine locally; Sentry simply stays quiet.
SENTRY_DSN=

# Only needed for the rider dashboard's position map. Without it that one card
# shows a blank tile; everything else works.
GOOGLE_MAPS_API_KEY=

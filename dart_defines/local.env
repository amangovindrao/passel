# Local development. Points at the backend running on this machine.
#
#   flutter run -d chrome --dart-define-from-file=../../dart_defines/local.env
#
# dev.env points at https://api.dev.paasel.thescaleon.com, which does not
# currently resolve — use this file for anything local.

FLAVOR=dev

# Chrome / desktop. For an Android emulator use http://10.0.2.2:8000 instead:
# the emulator reaches the host through 10.0.2.2, not localhost. On a physical
# device use your machine's LAN IP.
API_BASE_URL=http://localhost:8000

# REPLACE THESE. They are placeholders, and phone-OTP login cannot work until
# they point at a real Supabase project (or a local `supabase start` stack).
# The backend must be given the same project's SUPABASE_URL and
# SUPABASE_JWT_SECRET in paasel-backend/.env, or tokens will not verify.
SUPABASE_URL=https://local-project.supabase.co
SUPABASE_ANON_KEY=replace-me

# Optional. Sentry is happy to be empty locally.
SENTRY_DSN=
GOOGLE_MAPS_API_KEY=replace-me

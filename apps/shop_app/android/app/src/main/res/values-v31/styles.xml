<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 replaced the window-background splash with its own. Without
         this the platform draws the launcher icon on the default surface colour
         and ignores launch_background.xml entirely. -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowSplashScreenBackground">@color/paasel_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, used from Android 8 onward. The launcher masks the
     foreground to whatever shape the device uses, so the mark is drawn small
     and centred; the PNGs in mipmap-<density>/ic_launcher.png remain the
     fallback for anything older. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/paasel_ink" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- The pub workspace pulls camera_android_camerax into every app because
         packages/camera_kit depends on it, so CameraX's permissions arrive here
         uninvited. This app has no capture screen yet (that is Phase 11's
         pickup and delivery photos), and Paasel never records video at all — so
         strip them rather than ship permissions we cannot justify at review.
         Phase 11 should re-add CAMERA explicitly when it adds the feature. -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>

    <!-- Location. FINE is what dispatch needs; COARSE is declared alongside it
         because Android 12+ lets the user grant only the approximate one. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- The whole point of the rider app: keep reporting while backgrounded.
         Without this, tracking dies the moment the screen locks and the
         customer's map freezes mid-delivery. Android 10+ requires it to be
         requested separately, after foreground location has been granted. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Background location is only permitted from a foreground service, which
         must declare its type from Android 14 on. geolocator ships the service
         itself; these are the permissions it runs under. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- The ongoing "You're online and available" notification, and on 13+ the
         high-priority offer alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Keeps the location loop alive through Doze while a shift is running. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:label="Paasel Rider"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Offer alerts land on this channel when the app is backgrounded or
             closed. Declaring a high-importance channel is what actually makes
             them audible: the Dart isolate is asleep at that point, so the
             channel's own sound is the only thing that can wake the rider. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/offer_notification_channel_id" />

        <!-- The Maps SDK looks this up at initialisation and needs the entry to
             exist even when the value is blank. Populated from the mapsApiKey
             Gradle property or GOOGLE_MAPS_API_KEY; see app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

**/*.g.dart

# Platform directories are COMMITTED, not ignored.
#
# They started out as pure `flutter create` output, but they now carry
# hand-written configuration that flutter create will never regenerate:
# location and foreground-service permissions, the FCM notification channel,
# iOS background modes and usage strings. Ignoring these directories would mean
# a fresh clone silently loses all of it and CI cannot build.
#
# What follows is the generated and machine-local content *inside* them.

# Android — build output and local machine paths
**/android/.gradle/
**/android/.kotlin/
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# Android signing — never commit
**/android/key.properties
*.jks
*.keystore

# iOS — generated by the tool or by CocoaPods
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/Pods/
**/ios/Podfile.lock
**/ios/.symlinks/
**/ios/ServiceDefinitions.json
**/*.xcuserdatad/
**/xcuserdata/

# Desktop targets are not configured for this project
**/linux/
**/macos/
**/windows/

# Environment files — never commit secrets
.env
.env.*
